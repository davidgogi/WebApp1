DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
DB_DATABASE=webapp1
PORT=3000
# Optional. Key for encrypting stored secrets (the RS service user password). Falls back to AUTH_SECRET.
SECRETS_KEY=
# Required when NODE_ENV=production (the app refuses to start without them).
# AUTH_SECRET=
# SUPERUSER_USERNAME=superuser
# SUPERUSER_PASSWORD=
# Comma-separated browser origins allowed to call the API (default http://localhost:4200).
CORS_ORIGIN=http://localhost:4200
# DB_USERNAME (the owner) only syncs the tables and sets up the limited role and policies at startup.
# Requests run as the limited role webapp_app. The app creates it and works out its password from
# DB_PASSWORD, so nothing else is needed. Set these only to use a different name or your own password.
# DB_APP_USERNAME=
# DB_APP_PASSWORD=
