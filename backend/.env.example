DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
DB_DATABASE=webapp1
PORT=3000
# Optional. Key for encrypting stored secrets (the RS service user password). Falls back to AUTH_SECRET.
SECRETS_KEY=
# Required when NODE_ENV=production (the app refuses to start without them).
# AUTH_SECRET=
# SUPERUSER_USERNAME=superuser
# SUPERUSER_PASSWORD=
# Comma-separated browser origins allowed to call the API (default http://localhost:4200).
CORS_ORIGIN=http://localhost:4200
# true (default): tables follow the entities automatically. Set false once migrations exist.
DB_SYNCHRONIZE=true
