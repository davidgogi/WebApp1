diff --git a/backend/src/database/row-level-security.ts b/backend/src/database/row-level-security.ts
new file mode 100644
index 0000000..a526cbe
--- /dev/null
+++ b/backend/src/database/row-level-security.ts
@@ -0,0 +1,85 @@
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { DataSource } from 'typeorm';
+import { PostgresDataSourceOptions } from 'typeorm/driver/postgres/PostgresDataSourceOptions.js';
+import { PostgresQueryRunner } from 'typeorm/driver/postgres/PostgresQueryRunner.js';
+import { currentScope } from './tenant-scope.js';
+
+const POLICY = 'company_isolation';
+const ROLE_NAME = /^[a-z_][a-z0-9_]*$/;
+
+type ScopedClient = { query: (sql: string, values?: unknown[]) => Promise<unknown>; tenantKey?: string };
+
+let installed = false;
+
+export function installTenantSetting(): void {
+  if (installed) {
+    return;
+  }
+  installed = true;
+  const prototype = PostgresQueryRunner.prototype;
+  const query = prototype.query;
+  const rollbackTransaction = prototype.rollbackTransaction;
+
+  prototype.query = async function (this: PostgresQueryRunner, ...args: Parameters<typeof query>) {
+    const client = (await this.connect()) as ScopedClient;
+    const scope = currentScope();
+    const allCompanies = scope?.allCompanies ? 'on' : 'off';
+    const companyId = scope?.companyId ?? '';
+    const key = `${allCompanies}|${companyId}`;
+    if (client.tenantKey !== key) {
+      await client.query(
+        `SELECT set_config('app.all_companies', $1, false), set_config('app.company_id', $2, false)`,
+        [allCompanies, companyId],
+      );
+      client.tenantKey = key;
+    }
+    return query.apply(this, args);
+  } as typeof query;
+
+  prototype.rollbackTransaction = async function (this: PostgresQueryRunner) {
+    try {
+      await rollbackTransaction.call(this);
+    } finally {
+      if (this.databaseConnection) {
+        delete (this.databaseConnection as ScopedClient).tenantKey;
+      }
+    }
+  };
+}
+
+export async function prepareDatabase(
+  owner: PostgresDataSourceOptions,
+  appUser: string,
+  synchronize: boolean,
+): Promise<void> {
+  if (!ROLE_NAME.test(appUser)) {
+    throw new Error(`DB_APP_USERNAME "${appUser}" is not a plain role name`);
+  }
+  const dataSource = new DataSource({
+    ...owner,
+    entities: [join(dirname(fileURLToPath(import.meta.url)), '..', '**', '*.entity.js')],
+    synchronize,
+  });
+  await dataSource.initialize();
+  try {
+    await dataSource.transaction(async (manager) => {
+      const tables = await manager.query<{ table_name: string }[]>(
+        `SELECT table_name FROM information_schema.columns
+         WHERE table_schema = 'public' AND column_name = 'company_id'`,
+      );
+      const rule = `current_setting('app.all_companies', true) = 'on'
+        OR company_id = NULLIF(current_setting('app.company_id', true), '')::uuid`;
+      for (const { table_name } of tables) {
+        await manager.query(`ALTER TABLE "${table_name}" ENABLE ROW LEVEL SECURITY`);
+        await manager.query(`DROP POLICY IF EXISTS ${POLICY} ON "${table_name}"`);
+        await manager.query(`CREATE POLICY ${POLICY} ON "${table_name}" USING (${rule}) WITH CHECK (${rule})`);
+      }
+      await manager.query(`GRANT USAGE ON SCHEMA public TO ${appUser}`);
+      await manager.query(`GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO ${appUser}`);
+      await manager.query(`GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA public TO ${appUser}`);
+    });
+  } finally {
+    await dataSource.destroy();
+  }
+}
diff --git a/backend/src/database/tenant-scope.ts b/backend/src/database/tenant-scope.ts
new file mode 100644
index 0000000..07e6e75
--- /dev/null
+++ b/backend/src/database/tenant-scope.ts
@@ -0,0 +1,31 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { AuthUser } from '../auth/auth-user.js';
+import { UserRole } from '../auth/user-role.enum.js';
+
+export interface TenantScope {
+  companyId: string | null;
+  allCompanies: boolean;
+}
+
+const storage = new AsyncLocalStorage<TenantScope>();
+
+export function runInRequestScope(next: () => void): void {
+  storage.run({ companyId: null, allCompanies: false }, next);
+}
+
+export function scopeTo(user: Pick<AuthUser, 'role' | 'companyId'>): void {
+  const scope = storage.getStore();
+  if (!scope) {
+    return;
+  }
+  scope.allCompanies = user.role === UserRole.SUPERUSER;
+  scope.companyId = scope.allCompanies ? null : user.companyId;
+}
+
+export function acrossCompanies<T>(work: () => Promise<T>): Promise<T> {
+  return storage.run({ companyId: null, allCompanies: true }, work);
+}
+
+export function currentScope(): TenantScope | undefined {
+  return storage.getStore();
+}
