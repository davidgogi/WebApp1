server {
  listen 80;
  root /usr/share/nginx/html;

  # Excel imports are up to 5 MB.
  client_max_body_size 6m;

  # The API lives at /api/... for the browser; the backend itself has no /api prefix.
  # BACKEND_URL is filled in when the container starts (nginx image template, see Dockerfile).
  location /api/ {
    proxy_pass ${BACKEND_URL}/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # RS waybill lists can take up to 90 s.
    proxy_read_timeout 120s;
  }

  # Hashed files never change: cache them; index.html always fresh.
  location ~* \.(js|css|woff2?|png|svg|ico)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Angular routes (/wms/products, ...) are handled in the browser.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
